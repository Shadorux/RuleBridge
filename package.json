{
  "name": "@shadorux/rulebridge",
  "version": "0.1.0",
  "description": "ESLint for your AI coding-agent instructions: detect conflicts and safely reconcile agent rules.",
  "author": "Shadorux",
  "homepage": "https://github.com/Shadorux/RuleBridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shadorux/RuleBridge.git"
  },
  "bugs": {
    "url": "https://github.com/Shadorux/RuleBridge/issues"
  },
  "type": "module",
  "bin": {
    "rulebridge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "verify": "npm run check && npm test && npm run build",
    "start": "node dist/cli.js",
    "demo": "npm run build && node scripts/demo.mjs",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "ai-coding",
    "agents-md",
    "coding-agents",
    "codex",
    "openai-codex",
    "claude-code",
    "cursor",
    "github-copilot",
    "developer-tools",
    "cli",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
